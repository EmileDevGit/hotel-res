<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Vue.ChambresFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/ll_header_recherche"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="wrap_content"
            android:layout_width="match_parent">
            <TextView
                android:id="@+id/titreDetailsChambre"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@color/primary"
                android:textColor="@color/white"
                android:gravity="center"
                android:orientation="horizontal"
                android:text="Trouvez la chambre idéale"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Réserver de:"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btn_date_debut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textAlignment="center"
                    android:layout_weight="1"
                    android:hint="Cliquez ici"
                    style="?android:spinnerStyle"
                    android:backgroundTint="@color/primary"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" À: "
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btn_date_fin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textAlignment="center"
                    android:layout_weight="1"
                    android:hint="Date de fin"
                    style="?android:spinnerStyle" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prix maximum:"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_prix_maximum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:hint="Maximum"
                    android:inputType="numberSigned"
                    android:textAlignment="center" />

                <ImageView
                    android:id="@+id/btn_refresh_prix"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    app:tint="@color/primary"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/refresh_icon" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_weight="1"
            android:id="@+id/rv_chambres"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_header_recherche"
            app:layout_constraintBottom_toTopOf="@+id/bottom_banner"
            />

        <LinearLayout
            android:id="@+id/bottom_banner"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="@color/primary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:gravity="center_vertical" >

            <ImageView
                android:id="@+id/home_icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/home_icon"
                app:tint="@color/white"
                android:contentDescription="Home"
                android:padding="8dp"/>

            <ImageView
                android:id="@+id/vers_historique_reservation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/bookmark_icon"
                android:contentDescription="Save"
                android:padding="8dp"/>


            <ImageView
                android:id="@+id/profile_icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/profile_icon"
                android:contentDescription="Profile"
                android:padding="8dp"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>